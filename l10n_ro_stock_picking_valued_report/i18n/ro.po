#. module: l10n_ro_stock_picking_valued_report
#: model:base.comment.template,text:l10n_ro_stock_picking_valued_report.l10n_ro_picking_delivery_internTransfer
msgid ""
"\n"
"            <h2>\n"
"                <span>Delivery Order</span>\n"
"            </h2>\n"
"\n"
"            <t t-if=\"object.picking_type_code == 'internal'\">\n"
"                <table class=\"table table-condensed\">\n"
"                    <thead>\n"
"                        <tr>\n"
"                            <th>\n"
"                                Source Location\n"
"                            </th>\n"
"                            <th>\n"
"                                Destination Location\n"
"                            </th>\n"
"                        </tr>\n"
"                    </thead>\n"
"                    <tbody>\n"
"                        <tr>\n"
"                            <td>\n"
"                                <t t-out=\"object.location_id.name\"/>\n"
"                            </td>\n"
"                            <td>\n"
"                                <t t-out=\"object.location_dest_id.name\"/>\n"
"                            </td>\n"
"                        </tr>\n"
"                    </tbody>\n"
"                </table>\n"
"            </t>\n"
"            \n"
"        "
msgstr ""
"\n"
"            <h2>\n"
"                <span>Aviz de Însoțire a Mărfii</span>\n"
"            </h2>\n"
"\n"
"            <t t-if=\"object.picking_type_code == 'internal'\">\n"
"                <table class=\"table table-condensed\">\n"
"                    <thead>\n"
"                        <tr>\n"
"                            <th>\n"
"                                Locație Sursă\n"
"                            </th>\n"
"                            <th>\n"
"                                Locație Destinație\n"
"                            </th>\n"
"                        </tr>\n"
"                    </thead>\n"
"                    <tbody>\n"
"                        <tr>\n"
"                            <td>\n"
"                                <t t-out=\"object.location_id.name\"/>\n"
"                            </td>\n"
"                            <td>\n"
"                                <t t-out=\"object.location_dest_id.name\"/>\n"
"                            </td>\n"
"                        </tr>\n"
"                    </tbody>\n"
"                </table>\n"
"            </t>\n"
"            \n"
"        "

#. module: l10n_ro_stock_picking_valued_report
#: model:base.comment.template,text:l10n_ro_stock_picking_valued_report.l10n_ro_picking_in_up
msgid ""
"\n"
"            <h2><span>Reception Note and Differences</span></h2>\n"
"            <span>The undersigned, members of the reception commission, I received the material values provided by:\n"
"            <t t-esc=\"object.partner_id.name\"/>,\n"
"            delegate: <t t-esc=\"'.'*60\"/>,\n"
"            car no.: <t t-esc=\"'.'*32\"/>,\n"
"            based on the accompanying documents: <t t-esc=\"object.purchase_id.partner_ref+'; ' if object.purchase_id.partner_ref else  ''\"/>\n"
"                                                 <t t-esc=\"object.purchase_id.invoice_ids[0].name if object.purchase_id.invoice_ids else  ''\"/>\n"
"                                                 <t t-esc=\"'' if  object.purchase_id.invoice_ids or  object.purchase_id.partner_ref else  '.'*60\"/>, noting:\n"
"                                    </span>\n"
"        "
msgstr ""
"\n"
"            <h2><span>Notă de Intrare si Recepție</span></h2>\n"
"            <span>Subsemnații, membrii ai comisiei de recepție, am primit valorile materiale furnizate de:\n"
"            <t t-esc=\"object.partner_id.name\"/>,\n"
"            delegat: <t t-esc=\"'.'*60\"/>,\n"
"            auto nr.: <t t-esc=\"'.'*32\"/>,\n"
"            pe baza documentelor insoțitoare: <t t-esc=\"object.purchase_id.partner_ref+'; ' if object.purchase_id.partner_ref else  ''\"/>\n"
"                                                 <t t-esc=\"object.purchase_id.invoice_ids[0].name if object.purchase_id.invoice_ids else  ''\"/>\n"
"                                                 <t t-esc=\"'' if  object.purchase_id.invoice_ids or  object.purchase_id.partner_ref else  '.'*60\"/>, constatand:\n"
"                                    </span>\n"
"        "

